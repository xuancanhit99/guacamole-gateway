# Sao chép thành .env bằng scripts/setup.ps1 hoặc scripts/setup.sh.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080

POSTGRES_DB=guacamole
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_VALUE

GUACAMOLE_ADMIN_USERNAME=admin
GUACAMOLE_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE

GUACD_LOG_LEVEL=info
GUACAMOLE_LOG_LEVEL=info

